{
  "name": "stellarspend-api",
  "version": "1.0.0",
  "private": true,
  "description": "Secure financial management API for StellarSpend",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:debug": "node --inspect=0.0.0.0:9229 -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm migration:run -- -d ormconfig.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d ormconfig.ts",
    "migration:generate": "npm run typeorm migration:generate -- -d ormconfig.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/platform-socket.io": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.1",
    "@stellar/stellar-sdk": "11.3.0",
    "@willsoto/nestjs-prometheus": "6.1.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "joi": "17.13.5",
    "jsonwebtoken": "9.0.3",
    "nest-winston": "1.10.2",
    "nodemailer": "9.0.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "typeorm": "0.3.31",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/bcrypt": "5.0.2",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "8.57.1",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
